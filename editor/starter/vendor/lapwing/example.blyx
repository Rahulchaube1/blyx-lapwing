use lapwing;

fn main() {
    let blocks = [4, 6, 3];
    let paper = 120.0;
    let top = 10.0;
    let bottom = 10.0;
    let line = 10.0;
    let result = lapwing_paginate(blocks, paper, top, bottom, line);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
