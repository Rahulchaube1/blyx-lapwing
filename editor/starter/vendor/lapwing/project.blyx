use std::cli;
use console;
use lapwing;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Preflight fixed-line document pagination with indivisible paragraphs.");
        println!("Usage: lapwing blocks paper top bottom line");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = lapwing_paginate([4, 6, 3], 120.0, 10.0, 10.0, 10.0);
    } else {
        if count != 5 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let blocks = console_vector(args_at(argv, 0));
        let paper = console_value(args_at(argv, 1));
        let top = console_value(args_at(argv, 2));
        let bottom = console_value(args_at(argv, 3));
        let line = console_value(args_at(argv, 4));
        result = lapwing_paginate(blocks, paper, top, bottom, line);
    }
    if len(result) == 0 { stderr_line("Invalid input for Lapwing. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
